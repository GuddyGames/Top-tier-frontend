# Primary backend. Production currently uses the live Render backend.
VITE_API_URL=https://top-tier-backend-sbd5.onrender.com

# Optional comma-separated failover backends. The client will fail over on network/5xx/404 errors.
# VITE_API_URLS=https://top-tier-backend-sbd5.onrender.com,https://your-backup-backend.example.com

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_supabase_publishable_or_anon_key
